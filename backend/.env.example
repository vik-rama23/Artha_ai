# Copy this file to .env and replace the placeholder values locally.
# Never commit your real .env file or API credentials.

DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/artha
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

RECURRING_SCHEDULER_ENABLED=true
RECURRING_SCHEDULER_INTERVAL_SECONDS=3600

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30
